import React, { useCallback, useEffect, useRef, useState } from "react";
import { useParams } from "wouter";
import {
  ArrowLeft,
  ChevronLeft,
  ChevronRight,
  FileText,
  LockKeyhole,
  Maximize2,
  ShieldCheck,
  Volume2,
  ZoomIn,
  ZoomOut,
} from "lucide-react";
import { Button } from "@/components/ui/button";
import PasswordPrompt from "@/components/PasswordPrompt";
import {
  getPublishedFlipbook,
  requestFlipbookAccess,
  verifyFlipbookPassword,
} from "@/lib/supabase";

type PdfPage = {
  getViewport: (options: { scale: number }) => { width: number; height: number };
  getOperatorList?: () => Promise<unknown>;
  render: (options: {
    canvasContext: CanvasRenderingContext2D;
    viewport: { width: number; height: number };
    transform: [number, number, number, number, number, number];
  }) => { promise: Promise<void> };
};

type PdfDocument = {
  numPages: number;
  getPage: (page: number) => Promise<PdfPage>;
};

type PdfJs = {
  getDocument: (options: Record<string, unknown>) => { promise: Promise<PdfDocument> };
  GlobalWorkerOptions: { workerSrc: string };
};

type PanOffset = { x: number; y: number };

const PDF_JS_URL = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.min.mjs";
const PDF_WORKER_URL = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.worker.min.mjs";
// Keep the page inset identical on every device. In particular, do not let
// Samsung/browser safe-area calculations introduce an extra bottom gap.
const STAGE_CLEARANCE = 6;
const MAX_RENDER_ZOOM = 2.5;
const MAX_RENDER_PIXELS = 16_000_000;

async function loadPdfJs() {
  return import(/* @vite-ignore */ PDF_JS_URL) as Promise<PdfJs>;
}

function deviceId() {
  const key = "device_id";
  let id = localStorage.getItem(key);
  if (!id) {
    id = crypto.randomUUID();
    localStorage.setItem(key, id);
  }
  return id;
}

function AccessScreen({
  checking,
  error,
  unavailable,
  disabled,
  onCheck,
}: {
  checking: boolean;
  error: string;
  unavailable: boolean;
  disabled: boolean;
  onCheck: () => void;
}) {
  if (checking) {
    return (
      <div className="heyzin-screen">
        <div className="heyzin-loader">
          <div className="heyzin-loader-mark"><FileText className="h-6 w-6" /></div>
          <div className="heyzin-spinner" />
          <p>Preparing your reading room</p>
          <span>Checking your subscription securely.</span>
        </div>
      </div>
    );
  }

  return (
    <main className="heyzin-screen heyzin-access-screen">
      <div className="heyzin-access-glow heyzin-access-glow-one" />
      <div className="heyzin-access-glow heyzin-access-glow-two" />
      <section className="heyzin-access-card">
        <div className="heyzin-access-brand">
          <div className="heyzin-brand-lockup">
            <span className="heyzin-brand-icon"><FileText className="h-5 w-5" /></span>
           <span>MED-A <b>Reader</b></span>
          </div>
          <div className="heyzin-access-copy">
             <span className="heyzin-eyebrow">Your study room</span>
             <h1>Continue your MED-A study session.</h1>
             <p>Your protected course material, presented clearly for focused learning.</p>
          </div>
          <span className="heyzin-secure-note"><ShieldCheck className="h-4 w-4" /> Powered By ZetuBridge</span>
        </div>

        <div className="heyzin-access-form">
          <div className="heyzin-form-icon"><LockKeyhole className="h-6 w-6" /></div>
           <span className="heyzin-eyebrow">Protected MED-A library</span>
          <h2>{disabled ? "Account suspended" : "Unlock These Papers"}</h2>
           <p>{disabled ? "This account has been disabled. Please contact support to restore access." : "Choose a plan from the Subscription button in the top-left menu, then return here."}</p>
          {!disabled && (
            <>
              <div className="heyzin-steps">
                 <span>Three quick steps</span>
                <ol>
                   <li><b>1</b><span>Tap <em>Subscription</em> in the top-left menu.</span></li>
                   <li><b>2</b><span>Choose your plan and complete payment.</span></li>
                   <li><b>3</b><span>Return here and tap <em>Check my subscription</em>.</span></li>
                </ol>
              </div>
              {error && <p className="heyzin-error">{error}</p>}
              {unavailable && !error && <p className="heyzin-warning">We could not reach the subscription service. Please try again.</p>}
              <Button onClick={onCheck} className="heyzin-access-button">Check my subscription <ChevronRight className="h-4 w-4" /></Button>
            </>
          )}
        </div>
      </section>
    </main>
  );
}

function BottomControl({
  direction,
  disabled,
  onClick,
}: {
  direction: "previous" | "next";
  disabled: boolean;
  onClick: () => void;
}) {
  const previous = direction === "previous";
  return (
    <button
      type="button"
      aria-label={`${previous ? "Previous" : "Next"} page`}
      title={`${previous ? "Previous" : "Next"} page`}
      disabled={disabled}
      onClick={onClick}
      className={`heyzin-nav-button ${previous ? "heyzin-nav-prev" : "heyzin-nav-next"}`}
    >
      {previous ? <ChevronLeft className="h-5 w-5" /> : <ChevronRight className="h-5 w-5" />}
    </button>
  );
}

 export default function StudentFlipbookViewer() {
  const { id } = useParams<{ id: string }>();
  const [book, setBook] = useState<any>(null);
  const [pdf, setPdf] = useState<PdfDocument | null>(null);
  const [pageCount, setPageCount] = useState(0);
  const [page, setPage] = useState(1);
  const [mobile, setMobile] = useState(() => window.innerWidth < 768);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [access, setAccess] = useState(false);
  const [passwordRequired, setPasswordRequired] = useState(false);
  const [checkingAccess, setCheckingAccess] = useState(true);
  const [accessError, setAccessError] = useState("");
  const [serviceUnavailable, setServiceUnavailable] = useState(false);
  const [disabled, setDisabled] = useState(false);
  const [passwordOpen, setPasswordOpen] = useState(false);
  const [passwordError, setPasswordError] = useState("");
  const [passwordLoading, setPasswordLoading] = useState(false);
  const [renderVersion, setRenderVersion] = useState(0);
  const [pageRendering, setPageRendering] = useState(false);
  const [zoom, setZoom] = useState(1);
  const [pan, setPan] = useState<PanOffset>({ x: 0, y: 0 });
  const [isPanning, setIsPanning] = useState(false);
  const [turnDirection, setTurnDirection] = useState<"next" | "previous">("next");
  const [turnKey, setTurnKey] = useState(0);
  const pageCanvas = useRef<Record<number, HTMLCanvasElement | null>>({});
  const pageCache = useRef(new Map<number, PdfPage>());
  const pagePrefetches = useRef(new Map<number, Promise<PdfPage>>());
  const panStart = useRef<(PanOffset & { clientX: number; clientY: number; pointerId: number }) | null>(null);
  const activePointers = useRef(new Map<number, { x: number; y: number }>());
  const pinchStart = useRef<{ distance: number; zoom: number; pan: PanOffset } | null>(null);
  const lastTap = useRef<{ time: number; x: number; y: number } | null>(null);

  const checkAccess = useCallback(async () => {
    setCheckingAccess(true);
    setAccessError("");
    setServiceUnavailable(false);
    setPasswordRequired(false);
    const email = localStorage.getItem("user_email")?.trim().toLowerCase();
    if (!email) {
      setCheckingAccess(false);
      setAccessError("No saved subscription email was found. Please choose a plan from the Subscription menu, then try again.");
      return;
    }
    if (!id) {
      setCheckingAccess(false);
      setAccessError("This book could not be found.");
      return;
    }
    const result = await requestFlipbookAccess(id, email, deviceId());
    setCheckingAccess(false);
    setServiceUnavailable(Boolean(result.unavailable));
    if (result.disabled) {
      setDisabled(true);
      return;
    }
    if (!result.success) {
      setAccessError(result.error || "No active subscription was found for this email and device.");
      return;
    }
    setPasswordRequired(Boolean(result.passwordRequired));
    setAccess(true);
  }, [id]);

  useEffect(() => {
    void checkAccess();
    const resize = () => setMobile(window.innerWidth < 768);
    window.addEventListener("resize", resize);
    return () => window.removeEventListener("resize", resize);
  }, [checkAccess]);

  const openPdf = useCallback(async () => {
    if (!id) throw new Error("This book could not be found.");
    const pdfjs = await loadPdfJs();
    pdfjs.GlobalWorkerOptions.workerSrc = PDF_WORKER_URL;
    const keyResponse = await fetch(`/api/flipbooks/${encodeURIComponent(id)}/content/key`, {
      method: "POST",
      credentials: "include",
      cache: "no-store",
      headers: { Accept: "application/json" },
    });
    if (!keyResponse.ok) {
      const body = await keyResponse.json().catch(() => ({}));
      throw new Error(body.message || "Unable to open this protected book.");
    }
    const task = pdfjs.getDocument({
      url: `/api/flipbooks/${encodeURIComponent(id)}/content`,
      password: (await keyResponse.json()).documentPassword,
      withCredentials: true,
      disableAutoFetch: false,
      disableStream: false,
    });
    const document = await task.promise;
    setPdf(document);
    setPageCount(document.numPages);
    setPage(1);
  }, [id]);

  useEffect(() => {
    if (!access || !id) return;
    let cancelled = false;
    setLoading(true);
    setError("");
    void (async () => {
      try {
      const metadataPromise = getPublishedFlipbook(id);
      if (passwordRequired) {
        const data = await metadataPromise;
        if (!data) throw new Error("This book is not available.");
        if (cancelled) return;
        setBook(data);
        setPasswordOpen(true);
        setLoading(false);
        return;
      }
      const [data] = await Promise.all([metadataPromise, openPdf()]);
        if (!data) throw new Error("This book is not available.");
        if (cancelled) return;
        setBook(data);
      } catch (cause: any) {
        if (!cancelled) {
          setError(cause?.message || "Unable to open this book.");
          setLoading(false);
        }
      }
    })();
    return () => { cancelled = true; };
  }, [access, id, openPdf, passwordRequired]);

  const visiblePages = mobile ? [page] : [page, page + 1].filter((item) => item <= pageCount);

  const clampPan = useCallback((nextPan: PanOffset, viewport: HTMLElement, contentScale = 1) => {
    const canvas = viewport.querySelector("canvas");
    if (!canvas) return nextPan;
    const baseWidth = canvas.offsetWidth || Number.parseFloat(canvas.style.width) || canvas.clientWidth;
    const baseHeight = canvas.offsetHeight || Number.parseFloat(canvas.style.height) || canvas.clientHeight;
    const maxX = Math.max(0, (baseWidth * contentScale - viewport.clientWidth) / 2);
    const maxY = Math.max(0, (baseHeight * contentScale - viewport.clientHeight) / 2);
    return {
      x: Math.max(-maxX, Math.min(maxX, nextPan.x)),
      y: Math.max(-maxY, Math.min(maxY, nextPan.y)),
    };
  }, []);

  const changeZoom = useCallback((direction: "in" | "out") => {
    setZoom((currentZoom) => {
      const nextZoom = Math.min(MAX_RENDER_ZOOM, Math.max(1, currentZoom + (direction === "in" ? 0.25 : -0.25)));
      if (nextZoom !== currentZoom) {
        setPan((currentPan) => nextZoom === 1
          ? { x: 0, y: 0 }
          : {
              x: currentPan.x * nextZoom / currentZoom,
              y: currentPan.y * nextZoom / currentZoom,
            });
      }
      return nextZoom;
    });
  }, []);

  const pointerDistance = useCallback(() => {
    const pointers = Array.from(activePointers.current.values());
    if (pointers.length < 2) return 0;
    return Math.hypot(pointers[0].x - pointers[1].x, pointers[0].y - pointers[1].y);
  }, []);

  const handleWheel = useCallback((event: React.WheelEvent<HTMLDivElement>) => {
    event.preventDefault();
    const currentZoom = zoom;
    const nextZoom = Math.min(MAX_RENDER_ZOOM, Math.max(1, currentZoom + (event.deltaY < 0 ? 0.1 : -0.1)));
    if (nextZoom === currentZoom) return;

    const bounds = event.currentTarget.getBoundingClientRect();
    const cursorX = event.clientX - bounds.left - bounds.width / 2;
    const cursorY = event.clientY - bounds.top - bounds.height / 2;
    const ratio = nextZoom / currentZoom;
    const nextPan = {
      x: cursorX - (cursorX - pan.x) * ratio,
      y: cursorY - (cursorY - pan.y) * ratio,
    };

    setZoom(nextZoom);
    setPan(clampPan(nextPan, event.currentTarget, nextZoom));
  }, [clampPan, pan, zoom]);

  const beginPan = useCallback((event: React.PointerEvent<HTMLDivElement>) => {
    if (event.pointerType === "touch") {
      const now = performance.now();
      const previousTap = lastTap.current;
      const isDoubleTap = previousTap &&
        now - previousTap.time < 320 &&
        Math.hypot(previousTap.x - event.clientX, previousTap.y - event.clientY) < 30;

      if (isDoubleTap) {
        event.preventDefault();
        lastTap.current = null;
        const nextZoom = zoom > 1 ? 1 : 2;
        setZoom(nextZoom);
        setPan({ x: 0, y: 0 });
        return;
      }
      lastTap.current = { time: now, x: event.clientX, y: event.clientY };
      activePointers.current.set(event.pointerId, { x: event.clientX, y: event.clientY });
      if (activePointers.current.size === 2) {
        pinchStart.current = {
          distance: pointerDistance(),
          zoom,
          pan,
        };
        setIsPanning(false);
        event.currentTarget.setPointerCapture(event.pointerId);
        return;
      }
    }

    if (zoom <= 1) return;
    event.currentTarget.setPointerCapture(event.pointerId);
    panStart.current = {
      clientX: event.clientX,
      clientY: event.clientY,
      pointerId: event.pointerId,
      x: pan.x,
      y: pan.y,
    };
    setIsPanning(true);
  }, [pan, pointerDistance, zoom]);

  const movePan = useCallback((event: React.PointerEvent<HTMLDivElement>) => {
    if (event.pointerType === "touch") {
      const current = activePointers.current.get(event.pointerId);
      if (current) {
        activePointers.current.set(event.pointerId, { x: event.clientX, y: event.clientY });
      }
      const pinch = pinchStart.current;
      if (pinch && activePointers.current.size >= 2) {
        const distance = pointerDistance();
        if (!distance || !pinch.distance) return;
        const nextZoom = Math.min(MAX_RENDER_ZOOM, Math.max(1, pinch.zoom * distance / pinch.distance));
        setZoom(nextZoom);
        setPan(clampPan(pinch.pan, event.currentTarget, nextZoom));
        return;
      }
    }

    const start = panStart.current;
    if (!start || start.pointerId !== event.pointerId) return;
    setPan(clampPan({
      x: start.x + event.clientX - start.clientX,
      y: start.y + event.clientY - start.clientY,
    }, event.currentTarget, zoom));
  }, [clampPan, pointerDistance, zoom]);

  const endPan = useCallback((event: React.PointerEvent<HTMLDivElement>) => {
    if (event.pointerType === "touch") {
      activePointers.current.delete(event.pointerId);
      if (activePointers.current.size < 2) pinchStart.current = null;
      if (activePointers.current.size === 0) {
        panStart.current = null;
        setIsPanning(false);
      }
    }
    if (panStart.current?.pointerId !== event.pointerId) return;
    if (event.currentTarget.hasPointerCapture(event.pointerId)) {
      event.currentTarget.releasePointerCapture(event.pointerId);
    }
    panStart.current = null;
    setIsPanning(false);
  }, []);

  useEffect(() => {
    setPan({ x: 0, y: 0 });
  }, [page]);

  useEffect(() => {
    if (zoom <= 1) {
      setPan({ x: 0, y: 0 });
      return;
    }
    const viewport = document.querySelector<HTMLElement>(".heyzin-paper-viewport");
    if (viewport) {
      setPan((currentPan) => clampPan(currentPan, viewport, zoom));
    }
  }, [clampPan, zoom]);

  const getPdfPage = useCallback(async (pageNumber: number) => {
    if (!pdf) throw new Error("This book is still loading.");

    const cachedPage = pageCache.current.get(pageNumber);
    if (cachedPage) return cachedPage;

    const existingRequest = pagePrefetches.current.get(pageNumber);
    if (existingRequest) return existingRequest;

    const request = pdf.getPage(pageNumber)
      .then((documentPage) => {
        pageCache.current.set(pageNumber, documentPage);
        pagePrefetches.current.delete(pageNumber);
        return documentPage;
      })
      .catch((cause) => {
        pagePrefetches.current.delete(pageNumber);
        throw cause;
      });

    pagePrefetches.current.set(pageNumber, request);
    return request;
  }, [pdf]);

  const warmPage = useCallback(async (pageNumber: number) => {
    const documentPage = await getPdfPage(pageNumber);
    if (documentPage.getOperatorList) await documentPage.getOperatorList();
  }, [getPdfPage]);

  useEffect(() => {
    pageCache.current.clear();
    pagePrefetches.current.clear();
  }, [pdf]);

  const renderPage = useCallback(async (pageNumber: number) => {
    const canvas = pageCanvas.current[pageNumber];
    if (!pdf || !canvas) return false;
    const documentPage = await getPdfPage(pageNumber);
    const base = documentPage.getViewport({ scale: 1 });
    const roomWidth = Math.max(250, mobile ? window.innerWidth : Math.floor(window.innerWidth / 2));
    const viewportHeight = window.visualViewport?.height || window.innerHeight;
    const roomHeight = Math.max(300, viewportHeight - (mobile ? 132 : 154) - STAGE_CLEARANCE);
    const fitScale = Math.max(0.5, Math.min(3.8, Math.min(roomWidth / base.width, roomHeight / base.height)));
    const fitViewport = documentPage.getViewport({ scale: fitScale });
    const desiredRenderScale = fitScale * MAX_RENDER_ZOOM;
    const maxRenderScale = Math.sqrt(MAX_RENDER_PIXELS / (base.width * base.height));
    const renderScale = Math.max(fitScale, Math.min(desiredRenderScale, maxRenderScale));
    const renderViewport = documentPage.getViewport({ scale: renderScale });
    const deviceRatio = Math.min(window.devicePixelRatio || 1, 2.5);
    const pixelRatio = Math.max(
      1,
      Math.min(deviceRatio, Math.sqrt(MAX_RENDER_PIXELS / (renderViewport.width * renderViewport.height))),
    );
    const staged = document.createElement("canvas");
    staged.width = Math.ceil(renderViewport.width * pixelRatio);
    staged.height = Math.ceil(renderViewport.height * pixelRatio);
    await documentPage.render({
      canvasContext: staged.getContext("2d")!,
      viewport: renderViewport,
      transform: [pixelRatio, 0, 0, pixelRatio, 0, 0],
    }).promise;
    canvas.width = staged.width;
    canvas.height = staged.height;
    canvas.style.width = `${fitViewport.width}px`;
    canvas.style.height = `${fitViewport.height}px`;
    canvas.getContext("2d")!.drawImage(staged, 0, 0);
    return true;
  }, [getPdfPage, mobile, pdf]);

  useEffect(() => {
    if (!pdf) return;
    let cancelled = false;
    setPageRendering(true);
    void Promise.all(visiblePages.map((pageNumber) => renderPage(pageNumber)))
      .then((rendered) => {
        if (!cancelled && rendered.every(Boolean)) {
          setPageRendering(false);
          setLoading(false);
           const firstCanvas = pageCanvas.current[visiblePages[0]];
           const firstViewport = firstCanvas?.parentElement;
           if (firstViewport) {
             setPan((currentPan) => clampPan(currentPan, firstViewport));
           }
        }
      })
      .catch((cause) => {
        if (!cancelled) {
          setPageRendering(false);
          setLoading(false);
          setError(cause?.message || "Unable to render this page.");
        }
      });
    return () => { cancelled = true; };
  }, [clampPan, pageCount, pdf, renderPage, renderVersion, visiblePages.join(","), warmPage]);

  useEffect(() => {
    if (!pdf || pageCount === 0) return;
    let cancelled = false;
    const lastPageToWarm = Math.min(pageCount, page + 4);
    const warmAhead = window.setTimeout(async () => {
      for (let start = Math.max(4, page + 1); start <= lastPageToWarm && !cancelled; start += 4) {
        const batch = Array.from(
          { length: Math.min(4, lastPageToWarm - start + 1) },
          (_, offset) => start + offset,
        );
        await Promise.all(batch.map((pageNumber) => warmPage(pageNumber).catch(() => null)));
      }
    }, 400);
    return () => {
      cancelled = true;
      window.clearTimeout(warmAhead);
    };
  }, [page, pageCount, pdf, warmPage]);

  useEffect(() => {
    const resize = () => setRenderVersion((version) => version + 1);
    const viewport = window.visualViewport;
    window.addEventListener("resize", resize);
    window.addEventListener("orientationchange", resize);
    viewport?.addEventListener("resize", resize);
    return () => {
      window.removeEventListener("resize", resize);
      window.removeEventListener("orientationchange", resize);
      viewport?.removeEventListener("resize", resize);
    };
  }, []);

  const changePage = useCallback((direction: "next" | "previous") => {
    const step = mobile ? 1 : 2;
    setTurnDirection(direction);
    setTurnKey((value) => value + 1);
    setPage((value) => direction === "next" ? Math.min(Math.max(1, pageCount - (mobile ? 0 : 1)), value + step) : Math.max(1, value - step));
  }, [mobile, pageCount]);

  useEffect(() => {
    const keyboard = (event: KeyboardEvent) => {
      if (event.key === "ArrowLeft") changePage("previous");
      if (event.key === "ArrowRight") changePage("next");
    };
    window.addEventListener("keydown", keyboard);
    return () => window.removeEventListener("keydown", keyboard);
  }, [changePage]);

  const submitPassword = async (password: string) => {
    if (!id) return;
    setPasswordLoading(true);
    setPasswordError("");
    const email = localStorage.getItem("user_email")?.trim().toLowerCase();
    if (!email) {
      setPasswordError("Your subscription email is missing. Please go back and verify access again.");
      setPasswordLoading(false);
      return;
    }
    const result = await verifyFlipbookPassword(id, password, email, deviceId());
    if (!result.success) {
      setPasswordError(result.error || "Invalid password.");
    } else {
      setPasswordOpen(false);
      try {
        setLoading(true);
        await openPdf();
      } catch {
        setError("Unable to open this book.");
        setLoading(false);
      }
    }
    setPasswordLoading(false);
  };

  if (!access) {
    return <><style>{HEYZIN_STYLES}</style><AccessScreen checking={checkingAccess} error={accessError} unavailable={serviceUnavailable} disabled={disabled} onCheck={checkAccess} /></>;
  }

  if (error) {
    return (
      <>
        <style>{HEYZIN_STYLES}</style>
        <div className="heyzin-screen heyzin-error-screen">
          <div className="heyzin-error-card">
            <FileText className="mx-auto mb-4 h-10 w-10 text-[#ebc66a]" />
            <span className="heyzin-eyebrow">Reading room</span>
            <h2>This book could not be opened</h2>
            <p>{error}</p>
            <Button onClick={() => window.location.reload()} className="heyzin-access-button">Try again</Button>
          </div>
        </div>
      </>
    );
  }

  const progress = pageCount ? ((mobile ? page : Math.min(page + 1, pageCount)) / pageCount) * 100 : 0;

  return (
    <>
      <style>{HEYZIN_STYLES}</style>
      <div className="heyzin-viewer" onContextMenu={(event) => event.preventDefault()}>
        <header className="heyzin-topbar">
          <button type="button" aria-label="Back to library" onClick={() => window.history.back()} className="heyzin-back-button">
            <ArrowLeft className="h-4 w-4" />
          </button>
          <div className="heyzin-top-title">
            <span className="heyzin-mini-mark"><FileText className="h-3.5 w-3.5" /></span>
            <div className="heyzin-top-title-copy">
              <div className="heyzin-zoom-controls heyzin-title-zoom" aria-label="Page zoom controls">
                <button
                  type="button"
                  aria-label="Zoom out"
                  title="Zoom out"
                  onClick={() => changeZoom("out")}
                  disabled={zoom <= 1}
                  className="heyzin-zoom-button"
                >
                  <ZoomOut className="h-3.5 w-3.5" />
                </button>
                <span aria-live="polite">{Math.round(zoom * 100)}%</span>
                <button
                  type="button"
                  aria-label="Zoom in"
                  title="Zoom in"
                  onClick={() => changeZoom("in")}
                  disabled={zoom >= MAX_RENDER_ZOOM}
                  className="heyzin-zoom-button"
                >
                  <ZoomIn className="h-3.5 w-3.5" />
                </button>
              </div>
              <h1>{book?.title || "E-book viewer"}</h1>
              <span className="heyzin-top-subtitle"><ShieldCheck className="h-3 w-3" /> MED-A protected reading room</span>
            </div>
          </div>
          <div className="heyzin-top-actions">
            <button type="button" aria-label="Toggle sound" className="heyzin-icon-button"><Volume2 className="h-4 w-4" /></button>
            <button type="button" aria-label="Fullscreen" onClick={() => document.documentElement.requestFullscreen?.()} className="heyzin-icon-button"><Maximize2 className="h-4 w-4" /></button>
          </div>
        </header>

         <main className="heyzin-stage" aria-busy={loading || pageRendering}>
          <div className="heyzin-stage-glow" />
           {visiblePages.length > 0 && (
            <div key={turnKey} className={`heyzin-book-spread ${turnDirection === "next" ? "heyzin-turn-next" : "heyzin-turn-previous"} ${mobile ? "heyzin-single-page" : ""}`}>
              {visiblePages.map((pageNumber, index) => (
                <section
                  key={pageNumber}
                  className={`heyzin-paper ${mobile ? "heyzin-paper-mobile" : index === 0 ? "heyzin-paper-left" : "heyzin-paper-right"}`}
                >
                   <div
                     className="heyzin-paper-viewport"
                     onWheel={handleWheel}
                     onPointerDown={beginPan}
                     onPointerMove={movePan}
                     onPointerUp={endPan}
                     onPointerCancel={endPan}
                     style={{
                        cursor: zoom > 1 ? (isPanning ? "grabbing" : "grab") : "default",
                        touchAction: "none",
                     }}
                   >
                     <canvas
                       ref={(node) => { pageCanvas.current[pageNumber] = node; }}
                       aria-label={`Book page ${pageNumber}`}
                       style={{
                           transform: `translate3d(${pan.x}px, ${pan.y}px, 0) scale(${zoom})`,
                           transition: isPanning ? "none" : undefined,
                       }}
                     />
                   </div>
                  <span className="heyzin-paper-shadow" />
                </section>
              ))}
              {!mobile && visiblePages.length === 2 && <div className="heyzin-gutter" />}
            </div>
          )}
           {(loading || pageRendering) && (
             <div className="heyzin-loading-layer" role="status" aria-live="polite">
               <div className="heyzin-book-loading">
                 <div className="heyzin-loader-orbit" aria-hidden="true">
                   <span className="heyzin-loader-core" />
                 </div>
                 <div className="heyzin-loading-copy">
                   <strong>{loading ? "Opening your book" : "Turning the page"}</strong>
                   <span>{loading ? "Preparing a beautiful reading experience" : "Rendering your next view"}</span>
                 </div>
                 <div className="heyzin-loading-dots" aria-hidden="true"><i /><i /><i /></div>
               </div>
             </div>
           )}
        </main>

        <footer className="heyzin-bottom-bar">
           <BottomControl direction="previous" disabled={loading || pageRendering || page <= 1} onClick={() => changePage("previous")} />
          <div className="heyzin-progress-wrap">
            <div className="heyzin-progress-meta"><span>READING PROGRESS</span><span>{loading ? "Preparing" : "Keep going"}</span></div>
            <div className="heyzin-progress-track"><span style={{ width: `${progress}%` }} /></div>
          </div>
           <BottomControl direction="next" disabled={loading || pageRendering || page >= pageCount || (pageCount > 0 && !mobile && page + 1 >= pageCount)} onClick={() => changePage("next")} />
        </footer>
      </div>
      <PasswordPrompt isOpen={passwordOpen} onSubmit={submitPassword} onCancel={() => window.history.back()} isLoading={passwordLoading} error={passwordError} flipbookTitle={book?.title} />
    </>
  );
}

